{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "rootDir": "src/ts",
    "outDir": "js",
    "strict": true,
    "noImplicitThis": false,
    "removeComments": false,
    "newLine": "lf",
    "skipLibCheck": true
  },
  "include": ["src/ts/**/*.ts"]
}
